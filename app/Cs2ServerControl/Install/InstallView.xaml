<UserControl x:Class="Cs2ServerControl.Install.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:install="clr-namespace:Cs2ServerControl.Install">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Install" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="{Binding ResultText}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="{StaticResource FontSizeToolbar}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource CardGapColumn}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{StaticResource CardGapColumn}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Install or repair" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12"
                               Text="The CS2 server (copied from your Steam CS2 when there is one), Metamod, CounterStrikeSharp and our plugins. Safe to run again: downloads are cached and every step only fixes what is missing. The server has to be stopped." />
                    <Button Content="Install or repair" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                            Command="{Binding InstallServerCommand}" IsEnabled="{Binding CanStart}" />
                </StackPanel>
            </Border>
            <!-- Admins: who may grab players in game. Saved at once, a running server reloads it. -->
            <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding Admins}">
                <StackPanel>
                    <TextBlock Text="Admins" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding RuleText}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Admins}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Remove admin {0}}" />
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontSizeSmall}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SteamIdText}" Style="{StaticResource HintText}" FontFamily="{StaticResource MonoFont}"
                                                   VerticalAlignment="Center" Margin="8,0,8,0" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ItemsControl ItemsSource="{Binding OnlinePlayers}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="Make admin" Style="{StaticResource SmallSecondaryButton}"
                                            Command="{Binding DataContext.MakeAdminCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Make {0} admin}" />
                                    <TextBlock Text="{Binding Name, StringFormat=On the server: {0}}" Style="{StaticResource HintText}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource TextInput}" Tag="Name"
                                 Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Admin name" />
                        <TextBox Grid.Column="2" Style="{StaticResource TextInput}" Tag="SteamID or profile link"
                                 Text="{Binding SteamIdText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Admin SteamID" />
                        <Button Grid.Column="4" Content="Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource HintText}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Rebuild plugins" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,12"
                               Text="Copies server-files and the FunServer plugin into the server again and puts the Metamod line back after a CS2 update. The configs apply on the next map change." />
                    <Button Content="Rebuild plugins" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Command="{Binding RebuildPluginsCommand}" IsEnabled="{Binding CanStart}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Log" Style="{StaticResource CardTitleText}" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{StaticResource ViewportBackground}" BorderBrush="{StaticResource ConsoleBorder}"
                        BorderThickness="{StaticResource BorderOne}">
                    <ItemsControl x:Name="LogList" ItemsSource="{Binding Log}" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Install log">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer Padding="{StaticResource ConsolePadding}" CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type install:InstallMessage}">
                                <TextBlock x:Name="Line" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
                                           LineHeight="{StaticResource ConsoleLineHeight}" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{StaticResource TextTertiary}" Margin="16,0,0,0" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Step">
                                        <Setter TargetName="Line" Property="Foreground" Value="{StaticResource WireHigh}" />
                                        <Setter TargetName="Line" Property="Margin" Value="0,6,0,0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Problem">
                                        <Setter TargetName="Line" Property="Foreground" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
