<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Focus: 2 px accent rectangle with 2 px offset on every focusable control. -->
    <Style x:Key="AccentFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4" BorderBrush="{StaticResource Accent}" BorderThickness="2"
                            CornerRadius="{StaticResource RadiusRailItem}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text -->
    <Style x:Key="PageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style x:Key="SideCardTitleText" TargetType="TextBlock" BasedOn="{StaticResource CardTitleText}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSideCardTitle}" />
    </Style>
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="MonoCaptionText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderOne}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="LiveCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLiveCard}" />
        <Setter Property="Padding" Value="{StaticResource SideCardPadding}" />
    </Style>
    <Style x:Key="VerticalDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="{StaticResource DividerHeight}" />
        <Setter Property="Background" Value="{StaticResource CardBorder}" />
        <Setter Property="Margin" Value="3,0,3,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons. One template, the variants only change brushes. -->
    <ControlTemplate x:Key="FlatButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ButtonBaseStyle" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHover}" />
            </Trigger>
            <!-- A faded accent still reads as "press me"; disabled looks like a plain control. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource ControlBackground}" />
                <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource ControlBackground}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderOne}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource TextTertiary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SmallSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="{StaticResource SmallButtonHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DangerText}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderOne}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DangerText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeToolbar}" />
        <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToolbarToggle" TargetType="ToggleButton" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeToolbar}" />
        <Setter Property="Padding" Value="{StaticResource ToolbarButtonPadding}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CardToggle" TargetType="ToggleButton" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource ControlBackground}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderOne}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Height" Value="{StaticResource SmallButtonHeight}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Padding" Value="{StaticResource PillPadding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusChip}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control item (difficulty): a radio button that looks like a tab. -->
    <Style x:Key="SegmentButton" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Height" Value="{StaticResource SegmentHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ControlBackground}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Map row: radio circle in accent plus content, picked row gets the selection color. -->
    <Style x:Key="MapRowRadio" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}" Padding="12,4,8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="{StaticResource RadioSize}" Height="{StaticResource RadioSize}" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource ControlBorder}" StrokeThickness="1.5" Fill="{StaticResource TextPrimary}" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource OnAccent}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRow}" />
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource Accent}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mode tile: radio button with a card look. -->
    <Style x:Key="ModeTile" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="MinHeight" Value="{StaticResource ModeTileHeight}" />
        <Setter Property="Background" Value="{StaticResource ControlBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{StaticResource BorderOne}" CornerRadius="{StaticResource RadiusRailItem}"
                            Padding="12" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentTint}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Player row in the Live Map side panel. -->
    <Style x:Key="PlayerRowButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Height" Value="{StaticResource PlayerRowHeight}" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeToolbar}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource NavActive}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Inputs -->
    <Style x:Key="TextInput" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource InputBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderOne}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Focus" Margin="-4" BorderBrush="{StaticResource Accent}" BorderThickness="2"
                                CornerRadius="{StaticResource RadiusRailItem}" Visibility="Collapsed" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusControl}">
                            <Grid>
                                <!-- No margin: TextBox already hands its Padding to the content host, a margin here doubled it
                                     and put the caret 8 px right of the placeholder. -->
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="10,0,10,0" VerticalAlignment="Center"
                                           FontFamily="{TemplateBinding FontFamily}" Foreground="{StaticResource TextTertiary}"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RconInput" TargetType="TextBox" BasedOn="{StaticResource TextInput}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="BorderThickness" Value="{StaticResource RconInputBorder}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Focus" Margin="-4" BorderBrush="{StaticResource Accent}" BorderThickness="2"
                                CornerRadius="{StaticResource RadiusRailItem}" Visibility="Collapsed" />
                        <!-- Two borders, because WPF draws one brush per border: grey sides, accent bottom. -->
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource ControlBorder}"
                                BorderThickness="{StaticResource BorderOne}" CornerRadius="{StaticResource RadiusControl}" />
                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2" CornerRadius="{StaticResource RadiusControl}">
                            <Grid>
                                <!-- No margin: TextBox already hands its Padding to the content host, a margin here doubled it
                                     and put the caret 8 px right of the placeholder. -->
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="10,0,10,0" VerticalAlignment="Center"
                                           FontFamily="{TemplateBinding FontFamily}" Foreground="{StaticResource TextTertiary}"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Select (ComboBox) -->
    <ControlTemplate x:Key="SelectToggleTemplate" TargetType="ToggleButton">
        <Border Background="{StaticResource InputBackground}" BorderBrush="{StaticResource ControlBorder}"
                BorderThickness="{StaticResource BorderOne}" CornerRadius="{StaticResource RadiusControl}">
            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                  Data="M 0 0 L 5 5 L 10 0" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.6" />
        </Border>
    </ControlTemplate>

    <Style x:Key="SelectItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Item" Background="{StaticResource Transparent}" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource RadiusControl}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="{StaticResource SelectedRow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Select" TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource ControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SelectItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource SelectToggleTemplate}" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <!-- No AllowsTransparency: square corners need none, and a layered (transparent)
                             popup is drawn in software, which made every first open take a second or two. -->
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="2"
                               Focusable="False" PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource ControlBorder}"
                                    BorderThickness="{StaticResource BorderOne}" CornerRadius="{StaticResource RadiusControl}" Padding="4">
                                <ScrollViewer MaxHeight="300">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox: 18 px square, accent fill with a dark check mark. -->
    <Style x:Key="AccentCheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource AccentFocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="{StaticResource Transparent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="{StaticResource CheckBoxSize}" Height="{StaticResource CheckBoxSize}"
                                Background="{StaticResource TextPrimary}" BorderBrush="{StaticResource ControlBorder}"
                                BorderThickness="{StaticResource BorderOne}" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M 3.5 8.5 L 7 12 L 13.5 4.5" Stroke="{StaticResource OnAccent}"
                                  StrokeThickness="2" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark scroll bars, so the default light ones do not break the theme. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Margin" Value="{StaticResource VerticalScrollBarGap}" />
        <Setter Property="Background" Value="{StaticResource Transparent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource ControlBorder}" CornerRadius="{StaticResource RadiusControl}" Margin="1" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Margin" Value="{StaticResource HorizontalScrollBarGap}" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource ControlBorder}" CornerRadius="{StaticResource RadiusControl}" Margin="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Context menus: square, dark, the same card look as everything else. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeToolbar}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{StaticResource BorderOne}" Padding="4">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4,8,4" Background="{StaticResource CardBorder}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="{StaticResource Transparent}" Padding="8,7,12,7" MinWidth="190">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="Check" Data="M 1 5 L 4 8 L 10 1" Stroke="{StaticResource Accent}" StrokeThickness="2"
                                  VerticalAlignment="Center" Visibility="Collapsed" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <Path x:Name="Arrow" Grid.Column="2" Data="M 0 0 L 4 4 L 0 8" Stroke="{StaticResource TextSecondary}"
                                  StrokeThickness="1.5" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" VerticalOffset="-5"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False" PopupAnimation="None">
                                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource ControlBorder}"
                                        BorderThickness="{StaticResource BorderOne}" Padding="4">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectedRow}" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource CardBackground}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    </Style>
</ResourceDictionary>
