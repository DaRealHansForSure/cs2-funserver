<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Design tokens (spec section 5). Views use only these keys. Every color
         exists as a Color (key ends in "Color") and as a brush (plain key). -->

    <Color x:Key="WindowBackgroundColor">#1C1C1C</Color>
    <Color x:Key="RailBackgroundColor">#202020</Color>
    <Color x:Key="DividerSubtleColor">#2B2B2B</Color>
    <Color x:Key="CardBackgroundColor">#2B2B2B</Color>
    <Color x:Key="CardBorderColor">#3A3A3A</Color>
    <Color x:Key="ControlBackgroundColor">#323232</Color>
    <Color x:Key="ControlBorderColor">#4A4A4A</Color>
    <Color x:Key="InputBackgroundColor">#1F1F1F</Color>
    <Color x:Key="SelectedRowColor">#3A3A3A</Color>
    <Color x:Key="NavActiveColor">#2D2D2D</Color>
    <Color x:Key="ViewportBackgroundColor">#0F1316</Color>
    <Color x:Key="ConsoleBorderColor">#333333</Color>
    <Color x:Key="TextPrimaryColor">#F3F3F3</Color>
    <Color x:Key="TextSecondaryColor">#C8C8C8</Color>
    <Color x:Key="TextTertiaryColor">#A8A8A8</Color>
    <Color x:Key="TextDisabledColor">#8A8A8A</Color>
    <Color x:Key="AccentColor">#5ED3C0</Color>
    <Color x:Key="AccentHoverColor">#9BE7DA</Color>
    <Color x:Key="OnAccentColor">#0F1316</Color>
    <Color x:Key="AccentTintColor">#23332F</Color>
    <!-- The original GoldSrc team colors (death notices and scoreboard),
         chosen by the owner over the mockup's orange and blue. -->
    <Color x:Key="TeamTColor">#FF3F3F</Color>
    <Color x:Key="TeamCTColor">#99CCFF</Color>
    <Color x:Key="TeamSpectatorColor">#A8A8A8</Color>
    <Color x:Key="HookColor">#FF5BD1</Color>
    <!-- The HUD orange CS 1.6 draws its kill feed weapon icons in. -->
    <Color x:Key="KillIconColor">#FFA000</Color>
    <Color x:Key="WarningColor">#F2C66B</Color>
    <Color x:Key="SuccessDotColor">#57AB5A</Color>
    <Color x:Key="SuccessPillBackgroundColor">#1E3323</Color>
    <Color x:Key="SuccessPillTextColor">#A6E3AE</Color>
    <Color x:Key="DangerBorderColor">#8C3B3B</Color>
    <Color x:Key="DangerBackgroundColor">#3A2222</Color>
    <Color x:Key="DangerTextColor">#FFB4B4</Color>
    <Color x:Key="WireGridColor">#26403C</Color>
    <Color x:Key="WireLowColor">#3F7C72</Color>
    <Color x:Key="WireHighColor">#8FE0CF</Color>
    <Color x:Key="DeadMarkerColor">#8A949C</Color>
    <Color x:Key="AxisXColor">#E5534B</Color>
    <Color x:Key="AxisYColor">#57AB5A</Color>
    <Color x:Key="AxisZColor">#539BF5</Color>
    <Color x:Key="SelectionRingColor">#FFFFFF</Color>
    <!-- Nav mesh debug view: violet stays apart from the teal map and the team colors. -->

    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="RailBackground" Color="{StaticResource RailBackgroundColor}" />
    <SolidColorBrush x:Key="DividerSubtle" Color="{StaticResource DividerSubtleColor}" />
    <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBorder" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="ControlBackground" Color="{StaticResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBorder" Color="{StaticResource ControlBorderColor}" />
    <SolidColorBrush x:Key="InputBackground" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="SelectedRow" Color="{StaticResource SelectedRowColor}" />
    <SolidColorBrush x:Key="NavActive" Color="{StaticResource NavActiveColor}" />
    <SolidColorBrush x:Key="ViewportBackground" Color="{StaticResource ViewportBackgroundColor}" />
    <SolidColorBrush x:Key="ViewportLabelBackground" Color="{StaticResource ViewportBackgroundColor}" Opacity="0.8" />
    <SolidColorBrush x:Key="ConsoleBorder" Color="{StaticResource ConsoleBorderColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentTint" Color="{StaticResource AccentTintColor}" />
    <SolidColorBrush x:Key="TeamT" Color="{StaticResource TeamTColor}" />
    <SolidColorBrush x:Key="TeamCT" Color="{StaticResource TeamCTColor}" />
    <SolidColorBrush x:Key="TeamSpectator" Color="{StaticResource TeamSpectatorColor}" />
    <SolidColorBrush x:Key="Hook" Color="{StaticResource HookColor}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SuccessDot" Color="{StaticResource SuccessDotColor}" />
    <SolidColorBrush x:Key="SuccessPillBackground" Color="{StaticResource SuccessPillBackgroundColor}" />
    <SolidColorBrush x:Key="SuccessPillText" Color="{StaticResource SuccessPillTextColor}" />
    <SolidColorBrush x:Key="DangerBorder" Color="{StaticResource DangerBorderColor}" />
    <SolidColorBrush x:Key="DangerBackground" Color="{StaticResource DangerBackgroundColor}" />
    <SolidColorBrush x:Key="DangerText" Color="{StaticResource DangerTextColor}" />
    <SolidColorBrush x:Key="WireHigh" Color="{StaticResource WireHighColor}" />
    <SolidColorBrush x:Key="DeadMarker" Color="{StaticResource DeadMarkerColor}" />
    <SolidColorBrush x:Key="Transparent" Color="Transparent" />
    <!-- Dims the window behind a modal, so the dialog has the focus. -->
    <SolidColorBrush x:Key="ModalScrim" Color="#000000" Opacity="0.6" />

    <!-- Typography -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="FontSizePageTitle">28</sys:Double>
    <sys:Double x:Key="FontSizeCardTitle">16</sys:Double>
    <sys:Double x:Key="FontSizeSideCardTitle">14</sys:Double>
    <sys:Double x:Key="FontSizeMapTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeModeTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeToolbar">13</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="ConsoleLineHeight">19.2</sys:Double>

    <!-- Shapes. Square on purpose: the owner wants a plain tool look, no rounded
         corners and no shadows. Only the team dots and radio circles stay round. -->
    <CornerRadius x:Key="RadiusControl">0</CornerRadius>
    <CornerRadius x:Key="RadiusCard">0</CornerRadius>
    <CornerRadius x:Key="RadiusLiveCard">0</CornerRadius>
    <CornerRadius x:Key="RadiusRailItem">0</CornerRadius>
    <CornerRadius x:Key="RadiusPill">0</CornerRadius>
    <CornerRadius x:Key="RadiusChip">0</CornerRadius>
    <CornerRadius x:Key="RadiusActiveChip">0</CornerRadius>
    <CornerRadius x:Key="RadiusRailPill">0</CornerRadius>
    <CornerRadius x:Key="RadiusHpBar">0</CornerRadius>
    <CornerRadius x:Key="RadiusDot">5</CornerRadius>
    <CornerRadius x:Key="RadiusProgress">0</CornerRadius>

    <!-- Spacing and sizes -->
    <Thickness x:Key="PagePadding">24,20,24,20</Thickness>
    <Thickness x:Key="LivePagePadding">20,16,20,16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SideCardPadding">12</Thickness>
    <Thickness x:Key="DetailCardPadding">14</Thickness>
    <!-- Space between a list and its scroll bar, so numbers at the right edge stay readable. -->
    <Thickness x:Key="VerticalScrollBarGap">12,0,0,0</Thickness>
    <Thickness x:Key="HorizontalScrollBarGap">0,12,0,0</Thickness>
    <Thickness x:Key="ToolbarPadding">6</Thickness>
    <Thickness x:Key="ButtonPadding">16,0,16,0</Thickness>
    <Thickness x:Key="ToolbarButtonPadding">12,0,12,0</Thickness>
    <Thickness x:Key="PillPadding">12,4,12,4</Thickness>
    <Thickness x:Key="ActiveChipPadding">8,1,8,1</Thickness>
    <Thickness x:Key="ConsolePadding">12,10,12,10</Thickness>
    <Thickness x:Key="InfoBarPadding">24,7,24,7</Thickness>
    <Thickness x:Key="StatusBarPadding">14,4,14,4</Thickness>
    <Thickness x:Key="RailPadding">6,8,6,8</Thickness>
    <Thickness x:Key="TitleBarPadding">14,0,0,0</Thickness>
    <Thickness x:Key="OverlayMargin">14,12,14,12</Thickness>
    <Thickness x:Key="BorderOne">1</Thickness>
    <Thickness x:Key="BorderBottomOne">0,0,0,1</Thickness>
    <Thickness x:Key="BorderTopOne">0,1,0,0</Thickness>
    <Thickness x:Key="RconInputBorder">1,1,1,2</Thickness>

    <sys:Double x:Key="GapCards">16</sys:Double>
    <sys:Double x:Key="GapLive">12</sys:Double>
    <sys:Double x:Key="ControlHeight">36</sys:Double>
    <sys:Double x:Key="SmallButtonHeight">32</sys:Double>
    <!-- The game's kill icons are 16 px high at 640 x 480; a little smaller keeps rows calm. -->
    <sys:Double x:Key="WeaponIconHeight">14</sys:Double>
    <sys:Double x:Key="SegmentHeight">40</sys:Double>
    <sys:Double x:Key="PlayerRowHeight">34</sys:Double>
    <sys:Double x:Key="TableRowHeight">40</sys:Double>
    <sys:Double x:Key="ModeTileHeight">76</sys:Double>
    <sys:Double x:Key="TitleBarHeight">36</sys:Double>
    <sys:Double x:Key="CaptionButtonWidth">46</sys:Double>
    <sys:Double x:Key="RailWidth">80</sys:Double>
    <sys:Double x:Key="RailItemHeight">56</sys:Double>
    <sys:Double x:Key="RailIconSize">20</sys:Double>
    <sys:Double x:Key="RailIconStroke">1.6</sys:Double>
    <sys:Double x:Key="StatusBarHeight">28</sys:Double>
    <sys:Double x:Key="StatusDotSize">8</sys:Double>
    <sys:Double x:Key="TeamDotSize">10</sys:Double>
    <sys:Double x:Key="CheckBoxSize">18</sys:Double>
    <sys:Double x:Key="DividerHeight">22</sys:Double>
    <sys:Double x:Key="HpBarHeight">6</sys:Double>
    <sys:Double x:Key="ProgressBarHeight">4</sys:Double>
    <sys:Double x:Key="FocusThickness">2</sys:Double>
    <sys:Double x:Key="ViewportMinHeight">640</sys:Double>
    <sys:Double x:Key="ViewportMinWidth">560</sys:Double>
    <sys:Double x:Key="SidePanelMinWidth">300</sys:Double>
    <sys:Double x:Key="SidePanelMaxWidth">360</sys:Double>
    <sys:Double x:Key="ConsoleMinHeight">470</sys:Double>
    <sys:Double x:Key="RadioSize">18</sys:Double>
    <sys:Double x:Key="SelectMaxWidth">260</sys:Double>
    <sys:Double x:Key="ConfirmWidth">420</sys:Double>
    <sys:Double x:Key="MapDetailsWidth">900</sys:Double>

    <GridLength x:Key="StatusGap">18</GridLength>
    <GridLength x:Key="RailColumnWidth">80</GridLength>
    <GridLength x:Key="CardGapColumn">16</GridLength>
    <GridLength x:Key="LiveGapColumn">12</GridLength>
    <GridLength x:Key="CardGapRow">16</GridLength>
</ResourceDictionary>
