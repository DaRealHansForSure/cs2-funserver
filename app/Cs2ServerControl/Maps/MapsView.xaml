<UserControl x:Class="Cs2ServerControl.Maps.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Cs2ServerControl.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <services:ZeroToVisibleConverter x:Key="VisibleWhenZero" />

        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SmallSecondaryButton}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="56" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Maps" Style="{StaticResource PageTitleText}" />
                <Border Background="{StaticResource InputBackground}" Padding="4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Installed" Style="{StaticResource SegmentButton}" GroupName="MapsTab" Height="{StaticResource SmallButtonHeight}"
                                     Width="120" Margin="0,0,4,0" IsChecked="{Binding IsInstalledTab, Mode=TwoWay}" />
                        <RadioButton Content="Workshop" Style="{StaticResource SegmentButton}" GroupName="MapsTab" Height="{StaticResource SmallButtonHeight}"
                                     Width="120" IsChecked="{Binding IsWorkshopTab, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSizeToolbar}" Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="640" />
                <ColumnDefinition Width="{StaticResource CardGapColumn}" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Installed maps -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Visibility="{Binding IsInstalledTab, Converter={StaticResource VisibleWhenTrue}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource Select}" Width="200" ItemsSource="{Binding Filters}"
                                  SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Title" AutomationProperties.Name="Show" />
                        <TextBox DockPanel.Dock="Right" Style="{StaticResource TextInput}" Width="220" Margin="0,0,8,0" Tag="Search maps"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search maps" />
                        <TextBlock Text="Installed maps" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="{StaticResource BorderBottomOne}" Padding="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Map" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="2" Text="Modes" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="3" Text="Size" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <!-- Same width as the row buttons, so the columns above line up. -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Visibility="Hidden">
                                <Button Content="Details" Style="{StaticResource RowButton}" />
                                <Button Content="Pick" Style="{StaticResource RowButton}" />
                                <Button Content="Next" Style="{StaticResource RowButton}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="No map matches." Style="{StaticResource HintText}" Margin="0,10,0,0"
                                       Visibility="{Binding Rows.Count, Converter={StaticResource VisibleWhenZero}}" />
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource ConsoleBorder}" BorderThickness="{StaticResource BorderBottomOne}" Padding="0,5,0,5"
                                                Background="Transparent">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="64" Height="36" HorizontalAlignment="Left" Background="{StaticResource InputBackground}"
                                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="{StaticResource BorderOne}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeToolbar}"
                                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                <TextBlock x:Name="Modes" Grid.Column="2" Text="{Binding ModesText}" Style="{StaticResource Cell}" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Cell}" HorizontalAlignment="Right" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <Button Content="Details" Style="{StaticResource RowButton}"
                                                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Details of {0}}" />
                                                    <Button Content="Pick" Style="{StaticResource RowButton}" IsEnabled="{Binding CanPick}"
                                                            Command="{Binding DataContext.PickOnServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Pick this map on the Server screen (a draft until Apply)"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Pick {0} on the Server screen}" />
                                                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource RowButton}"
                                                            IsEnabled="{Binding DataContext.IsServerRunning, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding DataContext.SetNextMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Right away: this map comes after the current one"
                                                            AutomationProperties.Name="{Binding Name, StringFormat=Set {0} as next map}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsInNoMode}" Value="True">
                                                <Setter TargetName="Modes" Property="Foreground" Value="{StaticResource TextTertiary}" />
                                            </DataTrigger>
                                            <!-- nextlevel only knows the maps in the server's maps folder. -->
                                            <DataTrigger Binding="{Binding CanSetNext}" Value="False">
                                                <Setter TargetName="NextButton" Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Workshop: the host's Workshop maps, added by link -->
            <Border Grid.Column="0" Style="{StaticResource Card}" DataContext="{Binding Workshop}"
                    Visibility="{Binding DataContext.IsWorkshopTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhenTrue}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Browse the Workshop" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseCommand}"
                                ToolTip="Opens Steam's Workshop for CS2 maps in the browser; copy the address of a map you like" />
                        <TextBlock Text="Workshop maps" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource TextInput}" Tag="Workshop link or item number"
                                 Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Workshop link" />
                        <Button Grid.Column="2" Content="Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMessageAProblem}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Warning}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="No Workshop maps yet. Browse the Workshop, copy the address of a map page and add it here." Style="{StaticResource HintText}"
                                       TextWrapping="Wrap" Visibility="{Binding Rows.Count, Converter={StaticResource VisibleWhenZero}}" />
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource ConsoleBorder}" BorderThickness="{StaticResource BorderBottomOne}" Padding="0,6,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="100" Height="56" HorizontalAlignment="Left" Background="{StaticResource InputBackground}"
                                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="{StaticResource BorderOne}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimary}" FontSize="{StaticResource FontSizeToolbar}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                    <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0">
                                                        <Run Text="{Binding SizeText, Mode=OneWay}" /> · <Run Text="{Binding StateText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Pick" Style="{StaticResource RowButton}"
                                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Pick this map on the Server screen (a draft until Apply)"
                                                            AutomationProperties.Name="{Binding Title, StringFormat=Pick {0} on the Server screen}" />
                                                    <Button Content="Page" Style="{StaticResource RowButton}"
                                                            Command="{Binding DataContext.OpenPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Opens the map's Workshop page in the browser"
                                                            AutomationProperties.Name="{Binding Title, StringFormat=Workshop page of {0}}" />
                                                    <Button Content="Remove" Style="{StaticResource RowButton}"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat=Remove {0}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right column: where the maps and the map lists come from -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Map lists" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Text="Every mode plays the maps in its list, cfg\fun\mapcycle_&lt;mode&gt;.txt in the package. A map in no list can still be picked on the Server screen or set as the next map." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="More maps" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Text="The CS2 server comes with Valve's maps. More come from the Steam Workshop (Workshop tab): the server downloads a map when it starts it, the players' CS2 downloads it by itself when they join. Workshop maps are played by pick in any mode, not in the rotation." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Pictures" Style="{StaticResource CardTitleText}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                       Text="A .jpg or .png named after the map in tools\previews shows up here and on the Server screen." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
