<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- HelixToolkit loads WindowsFormsIntegration when the viewport starts. A
         self-contained publish only bundles what is referenced, WPF alone
         leaves that assembly out and the window fails at startup. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Cs2ServerControl</AssemblyName>
    <RootNamespace>Cs2ServerControl</RootNamespace>
    <Product>CS2 Server Control</Product>
    <Version>0.4.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PackageRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</PackageRoot>
  </PropertyGroup>

  <!-- dotnet publish -c Release: one self-contained exe, so the LAN PC needs
       no .NET installed. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests reach the parsers without making them public API. -->
    <InternalsVisibleTo Include="Cs2ServerControl.Tests" />
    <!-- Only the assembly is needed; its global usings would clash with WPF types. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- The window and taskbar icon, the same crosshair as in the title bar. -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The .NET (Core) build of HelixToolkit.Wpf.SharpDX 2.x: same API and namespace,
         the HelixToolkit.Wpf.SharpDX package itself only ships a .NET Framework build. -->
    <PackageReference Include="HelixToolkit.SharpDX.Core.Wpf" Version="2.27.3" />
    <!-- Reads the zip archives of Metamod and CounterStrikeSharp, and RAR or 7z should a mirror ship one. -->
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <!-- Reads CS2 map packages (.vpk) and their compiled resources: world collision for the Live Map, weapon icons. MIT. -->
    <PackageReference Include="ValveResourceFormat" Version="20.1.7467" />
    <!-- Turns the SVG kill feed icons from the game files into WPF drawings. BSD-3-Clause. -->
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
  </ItemGroup>

  <!-- A publish never ships an exe whose tests fail. The tests build into
       their own folder, so they do not touch this publish's files. -->
  <Target Name="RunTestsBeforePublish" BeforeTargets="PrepareForPublish" Condition="'$(SkipTests)' != 'true'">
    <Exec Command="dotnet test &quot;$(PackageRoot)app\Cs2ServerControl.Tests\Cs2ServerControl.Tests.csproj&quot; -nologo -v q --artifacts-path &quot;$(PackageRoot)app\.artifacts\tests&quot;" />
  </Target>

  <!-- The FunServer plugin for the CS2 server is built with every publish into
       plugins\FunServer next to the exe, where the installer picks it up. -->
  <Target Name="BuildServerPlugin" AfterTargets="Publish">
    <Exec Command="dotnet build &quot;$(PackageRoot)server-plugins\FunServer\FunServer.csproj&quot; -c Release -nologo -v q -o &quot;$(PackageRoot)plugins\FunServer&quot;" />
  </Target>

  <!-- An open window locks the exe. Windows still lets a running exe be
       renamed, so the old one moves aside into app\.artifacts\old and keeps
       running from there; the next start uses the new one. Old copies that no
       longer run are cleared first. -->
  <Target Name="CopyExeToPackageRoot" AfterTargets="BuildServerPlugin">
    <PropertyGroup>
      <TargetExe>$(PackageRoot)CS2_SERVER_CONTROL.exe</TargetExe>
      <OldExeDir>$(PackageRoot)app\.artifacts\old\</OldExeDir>
      <OldExe>$(OldExeDir)CS2_SERVER_CONTROL.$([System.DateTime]::Now.ToString('yyyyMMdd-HHmmss')).exe</OldExe>
    </PropertyGroup>
    <ItemGroup>
      <OldExeFile Include="$(OldExeDir)*.exe" />
    </ItemGroup>
    <Delete Files="@(OldExeFile)" ContinueOnError="true" />
    <MakeDir Directories="$(OldExeDir)" />
    <Move SourceFiles="$(TargetExe)" DestinationFiles="$(OldExe)" Condition="Exists('$(TargetExe)')" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(TargetExe)" />
    <Message Importance="high" Text="Done: $(TargetExe)" />
  </Target>

  <!-- -p:BuildReleaseZip=true also packs release\CS2-FunServer.zip (not PackRelease:
       the .NET SDK uses that name itself and turns it on by default): everything a
       LAN PC needs (the exe, README.txt, server-files and the built plugins),
       without the source code and docs. -->
  <Target Name="PackReleaseZip" AfterTargets="CopyExeToPackageRoot" Condition="'$(BuildReleaseZip)' == 'true'">
    <PropertyGroup>
      <ReleaseStagingRoot>$(PackageRoot)app\.artifacts\release\</ReleaseStagingRoot>
      <ReleaseStagingDir>$(ReleaseStagingRoot)CS2-FunServer\</ReleaseStagingDir>
      <ReleaseZip>$(PackageRoot)release\CS2-FunServer.zip</ReleaseZip>
    </PropertyGroup>
    <ItemGroup>
      <ReleaseFile Include="$(PackageRoot)README.txt;$(PackageRoot)CS2_SERVER_CONTROL.exe" />
      <ReleaseServerFile Include="$(PackageRoot)server-files\**\*" />
      <ReleasePluginFile Include="$(PackageRoot)plugins\**\*.dll" />
    </ItemGroup>
    <RemoveDir Directories="$(ReleaseStagingRoot)" />
    <Copy SourceFiles="@(ReleaseFile)" DestinationFolder="$(ReleaseStagingDir)" />
    <Copy SourceFiles="@(ReleaseServerFile)" DestinationFolder="$(ReleaseStagingDir)server-files\%(RecursiveDir)" />
    <Copy SourceFiles="@(ReleasePluginFile)" DestinationFolder="$(ReleaseStagingDir)plugins\%(RecursiveDir)" />
    <MakeDir Directories="$(PackageRoot)release" />
    <ZipDirectory SourceDirectory="$(ReleaseStagingRoot)" DestinationFile="$(ReleaseZip)" Overwrite="true" />
    <Message Importance="high" Text="Done: $(ReleaseZip)" />
  </Target>

</Project>
