<UserControl x:Class="Cs2ServerControl.Stats.PlayerDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Cs2ServerControl.Services"
             Width="{StaticResource MapDetailsWidth}">
    <UserControl.Resources>
        <services:ZeroToVisibleConverter x:Key="VisibleWhenZero" />

        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource ConsoleBorder}" />
            <Setter Property="BorderThickness" Value="{StaticResource BorderBottomOne}" />
            <Setter Property="MinHeight" Value="{StaticResource PlayerDetailsRowHeight}" />
        </Style>
        <Style x:Key="HeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="{StaticResource BorderBottomOne}" />
            <Setter Property="Padding" Value="0,0,0,4" />
        </Style>
        <Style x:Key="ListScroll" TargetType="ScrollViewer">
            <Setter Property="Height" Value="{StaticResource PlayerDetailsListHeight}" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Name and period -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}"
                        ToolTip="Close (Esc)" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Name, Mode=OneWay}" FontSize="{StaticResource FontSizeMapTitle}" FontWeight="SemiBold" />
                    <Run Text="{Binding BotText, Mode=OneWay}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextTertiary}" />
                    <Run Text="{Binding PeriodText, Mode=OneWay}" FontSize="{StaticResource FontSizeToolbar}" Foreground="{StaticResource TextTertiary}" />
                </TextBlock>
            </DockPanel>

            <!-- The numbers -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Tiles}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource InputBackground}" Padding="10,8,10,8" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextTertiary}" />
                                <TextBlock Text="{Binding Value}" FontSize="{StaticResource FontSizeMapTitle}" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="2" Style="{StaticResource HintText}" Margin="0,10,0,14">
                <Run Text="Favorite victim:" />
                <Run Text="{Binding FavoriteVictimText, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" />
                <Run Text="     Nemesis:" />
                <Run Text="{Binding NemesisText, Mode=OneWay}" Foreground="{StaticResource TextPrimary}" />
            </TextBlock>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource CardGapColumn}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{StaticResource CardGapRow}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Weapons -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Weapons" Style="{StaticResource LabelText}" />
                    <Border Style="{StaticResource HeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Weapon" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="2" Text="Kills" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Headshots" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <ScrollViewer Style="{StaticResource ListScroll}">
                        <StackPanel>
                            <TextBlock Text="No kills yet." Style="{StaticResource HintText}" Margin="0,6,0,0"
                                       Visibility="{Binding Weapons.Count, Converter={StaticResource VisibleWhenZero}}" />
                            <ItemsControl ItemsSource="{Binding Weapons}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Source="{Binding Icon}" Height="{StaticResource WeaponIconHeight}" Stretch="Uniform"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Cell}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Kills}" Style="{StaticResource NumberCell}" />
                                                <TextBlock Grid.Column="3" Text="{Binding HeadshotText}" Style="{StaticResource NumberCell}"
                                                           Foreground="{StaticResource TextSecondary}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <!-- Opponents -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Opponents" Style="{StaticResource LabelText}" />
                    <Border Style="{StaticResource HeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Player" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="1" Text="Killed them" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Killed by" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <ScrollViewer Style="{StaticResource ListScroll}">
                        <ItemsControl ItemsSource="{Binding Opponents}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Cell}">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding BotText, Mode=OneWay}" FontSize="{StaticResource FontSizeCaption}"
                                                     Foreground="{StaticResource TextTertiary}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Text="{Binding Kills}" Style="{StaticResource NumberCell}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Deaths}" Style="{StaticResource NumberCell}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Maps -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Maps" Style="{StaticResource LabelText}" />
                    <Border Style="{StaticResource HeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Map" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="1" Text="Kills" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="Deaths" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="K/D" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <ScrollViewer Style="{StaticResource ListScroll}">
                        <ItemsControl ItemsSource="{Binding Maps}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Map}" Style="{StaticResource Cell}" FontFamily="{StaticResource MonoFont}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kills}" Style="{StaticResource NumberCell}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Deaths}" Style="{StaticResource NumberCell}" />
                                            <TextBlock Grid.Column="3" Text="{Binding KillDeathText}" Style="{StaticResource NumberCell}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- Latest kills and deaths -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Latest kills and deaths" Style="{StaticResource LabelText}" />
                    <Border Style="{StaticResource HeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Time" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="1" Text="What" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="2" Text="Weapon" Style="{StaticResource HeaderCell}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Style="{StaticResource ListScroll}">
                        <ItemsControl ItemsSource="{Binding RecentEvents}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Cell}" FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource TextTertiary}" />
                                            <TextBlock x:Name="EventText" Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Cell}"
                                                       Foreground="{StaticResource DangerText}" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{Binding WeaponIcon}" Height="{StaticResource WeaponIconHeight}" Stretch="Uniform"
                                                       ToolTip="{Binding WeaponName}" />
                                                <TextBlock x:Name="HeadshotTag" Text="" Style="{StaticResource Cell}" Margin="6,0,0,0"
                                                           Foreground="{StaticResource TextTertiary}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsKill}" Value="True">
                                            <Setter TargetName="EventText" Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsHeadshot}" Value="True">
                                            <Setter TargetName="HeadshotTag" Property="Text" Value="HS" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
