<UserControl x:Class="Cs2ServerControl.Stats.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:Cs2ServerControl.Services"
             xmlns:livemap="clr-namespace:Cs2ServerControl.LiveMap">
    <UserControl.Resources>
        <services:ZeroToVisibleConverter x:Key="VisibleWhenZero" />

        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource HintText}">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeToolbar}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Hide bots" Style="{StaticResource AccentCheckBox}" IsChecked="{Binding HideBots}" Margin="0,0,16,0"
                          VerticalAlignment="Center" />
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Stats" Style="{StaticResource PageTitleText}" />
                <Border Background="{StaticResource InputBackground}" Padding="4" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="This map" Style="{StaticResource SegmentButton}" GroupName="StatsPeriod" Height="{StaticResource SmallButtonHeight}"
                                     Width="120" Margin="0,0,4,0" IsChecked="{Binding IsThisMap, Mode=TwoWay}" />
                        <RadioButton Content="Last 12 hours" Style="{StaticResource SegmentButton}" GroupName="StatsPeriod" Height="{StaticResource SmallButtonHeight}"
                                     Width="120" IsChecked="{Binding IsEvening, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Summary}" FontSize="{StaticResource FontSizeToolbar}" Foreground="{StaticResource TextTertiary}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" MinWidth="640" />
                <ColumnDefinition Width="{StaticResource CardGapColumn}" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Leaderboard -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Right" Text="Click a player for the details" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                        <TextBlock Text="Leaderboard" Style="{StaticResource CardTitleText}" />
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="{StaticResource BorderBottomOne}" Padding="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="1" Text="Player" Style="{StaticResource HeaderCell}" />
                            <TextBlock Grid.Column="2" Text="Kills" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Deaths" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="K/D" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="HS" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="Streak" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" ToolTip="Most kills in a row" />
                            <TextBlock Grid.Column="7" Text="Knife" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="8" Text="HE" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="9" Text="Best weapon" Style="{StaticResource HeaderCell}" Margin="16,0,0,0" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="No kills in the logs for this period yet." Style="{StaticResource HintText}" Margin="0,10,0,0"
                                       Visibility="{Binding Leaderboard.Count, Converter={StaticResource VisibleWhenZero}}" />
                            <ItemsControl ItemsSource="{Binding Leaderboard}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource ConsoleBorder}" BorderThickness="{StaticResource BorderBottomOne}"
                                                MinHeight="{StaticResource PlayerRowHeight}">
                                            <Button Style="{StaticResource PlayerRowButton}" Padding="0"
                                                    Command="{Binding DataContext.ShowPlayerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Details of this player"
                                                    AutomationProperties.Name="{Binding Stats.Name, StringFormat=Details of {0}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" Foreground="{StaticResource TextTertiary}"
                                                               FontSize="{StaticResource FontSizeToolbar}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               FontSize="{StaticResource FontSizeToolbar}">
                                                        <Run Text="{Binding Stats.Name, Mode=OneWay}" />
                                                        <Run x:Name="BotTag" Text="" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextTertiary}" />
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding Stats.Kills}" Style="{StaticResource NumberCell}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Stats.Deaths}" Style="{StaticResource NumberCell}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding KillDeathText}" Style="{StaticResource NumberCell}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding HeadshotText}" Style="{StaticResource NumberCell}" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Stats.BestStreak}" Style="{StaticResource NumberCell}" />
                                                    <TextBlock Grid.Column="7" Text="{Binding Stats.KnifeKills}" Style="{StaticResource NumberCell}" />
                                                    <TextBlock Grid.Column="8" Text="{Binding Stats.GrenadeKills}" Style="{StaticResource NumberCell}" />
                                                    <TextBlock Grid.Column="9" Text="{Binding WeaponText}" FontSize="{StaticResource FontSizeToolbar}"
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                                </Grid>
                                            </Button>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Stats.IsBot}" Value="True">
                                                <Setter TargetName="BotTag" Property="Text" Value=" BOT" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{StaticResource CardGapRow}" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="This map" Style="{StaticResource CardTitleText}" Margin="0,0,0,12" />
                        <Grid Height="{StaticResource HpBarHeight}" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding MapProgress, Converter={livemap:PercentToStarConverter}}" />
                                <ColumnDefinition Width="{Binding MapProgress, Converter={livemap:PercentToStarConverter Remainder=True}}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="{StaticResource CardBorder}" />
                            <Border Grid.Column="0" Background="{StaticResource Accent}" />
                        </Grid>
                        <TextBlock Text="{Binding MapProgressText}" Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Maps tonight" Style="{StaticResource CardTitleText}" Margin="0,0,0,12" />
                        <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="{StaticResource BorderBottomOne}" Padding="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="1" Text="Map" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="2" Text="Mode" Style="{StaticResource HeaderCell}" />
                                <TextBlock Grid.Column="3" Text="Played" Style="{StaticResource HeaderCell}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel>
                                <TextBlock Text="No map changes in the last 12 hours." Style="{StaticResource HintText}" Margin="0,10,0,0"
                                           Visibility="{Binding MapsPlayed.Count, Converter={StaticResource VisibleWhenZero}}" />
                                <ItemsControl ItemsSource="{Binding MapsPlayed}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource ConsoleBorder}" BorderThickness="{StaticResource BorderBottomOne}"
                                                    MinHeight="{StaticResource PlayerRowHeight}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="100" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding StartText}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Play.Map}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="{StaticResource FontSizeToolbar}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ModeTitle}" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource NumberCell}"
                                                               FontSize="{StaticResource FontSizeSmall}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
